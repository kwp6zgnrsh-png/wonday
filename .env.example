# MySQL port on your machine (use 3307 if 3306 is in use)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
RABBITMQ_PASSWORD=change-me-rabbitmq
# Insurance-to-farm verification (server credential, shared with farm-api)
FARM_API_BASE_URL=http://127.0.0.1:8081
FARM_API_SERVICE_TOKEN=change-me-farm-service-token
# Daily work-change polling at 18:00 GMT+9 (enable after configuring farm connection)
FARM_WORK_POLLING_ENABLED=false
