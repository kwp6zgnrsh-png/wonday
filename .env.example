# MySQL port on your machine (use 3307 if 3306 is in use)
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PASSWORD=change-me-app
RABBITMQ_PASSWORD=change-me-rabbitmq
# Required for insurance startup: Base64 of 32 random bytes. Keep the same secret across restarts.
INSURANCE_IDENTITY_ENCRYPTION_KEY=replace-with-a-generated-base64-key
# Insurance-to-farm verification (server credential, shared with farm-api)
FARM_API_BASE_URL=http://127.0.0.1:8081
FARM_API_SERVICE_TOKEN=change-me-farm-service-token
# Enable only after farm /api/internal/insurance/v2/worker-verifications is available.
FARM_WORKER_VERIFICATION_V2_ENABLED=false
# Enable after farm /api/internal/insurance/workers/{workerId}/salary-account is ready.
FARM_SALARY_ACCOUNT_QUERY_ENABLED=false
# Daily work-change polling at 18:00 GMT+9 (enable after configuring farm connection)
FARM_WORK_POLLING_ENABLED=false

# Farm identity storage: explicit cutover after reviewed migration
FARM_IDENTITY_LOOKUP_MODE=LEGACY
# Supply different random 32-byte Base64 keys through your secret environment.
FARM_IDENTITY_ENCRYPTION_KEY=
FARM_IDENTITY_HMAC_KEY=
# Explicit JDBC URL for manual identity migration only; not read automatically from .env by the CLI.
FARM_IDENTITY_MIGRATION_JDBC_URL=

# Salary accounts: separate random 32-byte Base64 key; required only when storing an account.
FARM_SALARY_ACCOUNT_ENCRYPTION_KEY=
